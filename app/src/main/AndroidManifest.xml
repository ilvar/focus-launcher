<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Screen-time numbers, app timers and the weekly review all come from the system usage log. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- A launcher has to see every installed app. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- "Uninstall" in the long-press menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- "Your weekly review is ready", and "time's up" when Focus may not display over other apps. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The service that watches app timers while another app is open (see TimerWatchService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Optional, switched on by the user: lets the "time's up" screen come up in front of the app
         that ran out of time. Without it Focus sends a notification instead. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Optional calendar section on the home screen. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Swipe down on the home screen to open notifications. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <application
        android:name=".FocusApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Focus">

        <!-- The launcher itself: home page + app drawer. -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Shows up in the app list as "Focus Settings", so settings stay reachable from any launcher.
             Its own task affinity is what makes that true: sharing the home task's, a launcher
             start (NEW_TASK) only brought the home screen forward and never opened this. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_label"
            android:taskAffinity="com.focus.launcher.settings"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ReviewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Full-screen "time's up" wall. Lives in its own task so it can sit on top of the limited app. -->
        <activity
            android:name=".BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="false"
            android:taskAffinity="com.focus.launcher.block" />

        <!-- Watches app timers while another app is open, by reading the usage log. It runs only
             between leaving the home screen and coming back to it. Deliberately NOT an accessibility
             service and NOT a notification listener: an APK that declares either is blocked by
             Google Play Protect when it is installed from a download. -->
        <service
            android:name=".service.TimerWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Locks an app when the daily time limit the user set for it runs out, while that app is in use." />
        </service>

        <receiver
            android:name=".service.WeeklyReviewReceiver"
            android:exported="false" />
    </application>
</manifest>
